{
  "name": "frontend-base-react",
  "description": "Frontend base realizado con react en su última version con react, hooks, material-ui y otras tecnologías",
  "author": "dbarra@agetic.gob.bo",
  "version": "1.0.0",
  "private": false,
  "dependencies": {
    "@material-ui/core": "^4.9.12",
    "@material-ui/icons": "^4.9.1",
    "@material-ui/lab": "^4.0.0-alpha.51",
    "axios": "^0.19.2",
    "react": "16.13.1",
    "react-dom": "16.13.1",
    "react-redux": "^7.2.0",
    "react-router-dom": "^5.1.2",
    "react-scripts": "3.4.1",
    "redux": "^4.0.5",
    "redux-thunk": "^2.3.0",
    "typeface-roboto": "0.0.75"
  },
  "scripts": {
    "start": "PORT=8080 EXTEND_ESLINT=true react-scripts start",
    "secure": "HTTPS=true npm start",
    "server": "nodemon server.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "airbnb"
    ],
    "rules": {
      "react-hooks/exhaustive-deps": "off",
      "eslint-disable-next-line": "off",
      "comma-dangle": "off",
      "react/prop-types": "off",
      "react/jsx-wrap-multilines": "off",
      "react/jsx-tag-spacing": "off",
      "react/no-array-index-key": "off",
      "max-len": "off",
      "import/no-extraneous-dependencies": "off",
      "object-curly-newline": "off",
      "no-floating-decimal": "off",
      "no-shadow": "off",
      "react/jsx-closing-tag-location": "off",
      "react/jsx-fragments": "off",
      "no-console": "off",
      "react/jsx-filename-extension": "off",
      "space-before-function-paren": "off",
      "no-restricted-syntax": "off",
      "guard-for-in": "off",
      "arrow-parens": "off",
      "no-nested-ternary": "off",
      "radix": "off",
      "import/prefer-default-export": "off",
      "no-restricted-globals": "off",
      "no-async-promise-executor": "off",
      "consistent-return": "off",
      "no-param-reassign": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint-config-airbnb": "^18.1.0",
    "node-sass": "^4.14.0",
    "redux-devtools": "^3.5.0",
    "redux-devtools-extension": "^2.13.8"
  }
}
